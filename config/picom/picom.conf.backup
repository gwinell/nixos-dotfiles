# ==========================================
# BACKEND (СТРОГО XRENDER ДЛЯ ВИРТУАЛОК)
# ==========================================
backend = "xrender";
use-damage = false;
# vsync в виртуалках лучше отключить, им управляет хост-система

# ==========================================
# CORNERS
# ==========================================
corner-radius = 12;
round-borders = 1;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
];

# ==========================================
# SHADOWS (Оставляем, xrender с ними справляется)
# ==========================================
shadow = true;
shadow-radius = 15;
shadow-offset-x = -15;
shadow-offset-y = -15;
shadow-opacity = 0.5;
shadow-exclude = [
  "name = 'Notification'",
  "class_g = 'Polybar'",
  "_GTK_FRAME_EXTENTS@:c"
];

# ==========================================
# FADING (Плавное появление)
# ==========================================
fading = true;
fade-delta = 5;
fade-in-step = 0.03;
fade-out-step = 0.03;

# ==========================================
# TRANSPARENCY (Прозрачность без размытия)
# ==========================================
inactive-opacity = 0.65; # Неактивные окна будут прозрачными на 85%
active-opacity = 1.0;    # Активное окно на 100%
frame-opacity = 1.0;

# РАЗМЫТИЕ ПОЛНОСТЬЮ ОТКЛЮЧЕНО
